# 🔧 原点社区 · 基础配置

# Session 密钥（必填！至少 64 位随机 hex 字符）
# 可用 openssl rand -hex 32 生成
# SECRET=


# 🔧 原点社区 · 邮件配置
# 启用以下任意一组即可。同时启用多组时以第一组为准。

# ─── QQ邮箱（国内推荐）───
# 设置 → 账户 → POP3/SMTP → 生成授权码
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=你的QQ号@qq.com
# SMTP_PASS=授权码（非登录密码）
# SMTP_FROM=你的QQ号@qq.com

# ─── 163邮箱（国内推荐）───
# 设置 → POP3/SMTP/IMAP → 开启 → 设置授权码
# SMTP_HOST=smtp.163.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=你的邮箱@163.com
# SMTP_PASS=授权码
# SMTP_FROM=你的邮箱@163.com

# ─── Gmail ───
# 需要 Google 账号设置应用专用密码
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=你的邮箱@gmail.com
# SMTP_PASS=应用专用密码
# SMTP_FROM=你的邮箱@gmail.com

# ─── Outlook ───
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=你的邮箱@outlook.com
# SMTP_PASS=密码
# SMTP_FROM=你的邮箱@outlook.com

# ─── 公网访问地址 ───
# 邮件中的链接会使用此地址。不配置则用请求来源地址。
# PUBLIC_URL=http://你的域名或IP:3456
